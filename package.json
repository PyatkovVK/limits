{
  "name": "limits",
  "version": "0.3.0",
  "description": "Compact Codex subscription limits on the Windows taskbar",
  "author": "Codex Limits contributors",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "start": "npm run prepare:app && electron .",
    "demo": "npm run prepare:app && electron . --demo",
    "test": "node --test test/*.test.cjs",
    "doctor": "node scripts/doctor.cjs",
    "smoke": "npm run prepare:app && electron . --demo --smoke-test",
    "smoke:live": "npm run prepare:app && electron . --smoke-test",
    "prepare:app": "node scripts/assets.cjs && node scripts/build-taskbar-helper.cjs",
    "prepare:assets": "node scripts/assets.cjs",
    "build:win": "node scripts/build-windows.cjs",
    "build:win:standalone": "node scripts/build-windows.cjs --standalone"
  },
  "devDependencies": {
    "@openai/codex": "0.162.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": { "sprintf-js": "1.1.4" },
  "build": {
    "appId": "dev.codexlimits.desktop",
    "productName": "Codex Limits",
    "directories": { "output": "release" },
    "files": ["src/**/*", "assets/app.ico", "package.json", "LICENSE", "!node_modules/**/*"],
    "extraResources": [
      { "from": "build/taskbar-helper.exe", "to": "taskbar-helper.exe" },
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "win": { "target": ["portable", "nsis"], "icon": "assets/app.ico", "signExecutable": false },
    "electronLanguages": ["en-US", "ru"],
    "compression": "maximum",
    "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "include": "native/installer.nsh", "installerLanguages": ["en_US", "ru_RU"], "displayLanguageSelector": true, "artifactName": "Codex-Limits-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Codex-Limits-${version}-portable.${ext}" }
  }
}
