{
  "name": "limits",
  "version": "1.3.0",
  "description": "Compact AI usage limits in your taskbar or system tray",
  "author": "Limits contributors",
  "homepage": "https://github.com/PyatkovVK/limits",
  "license": "MIT",
  "main": "src/common/main.cjs",
  "scripts": {
    "================SERVE================": "",
    "start": "npm run prepare:app && electron .",
    "demo": "npm run prepare:app && electron . --demo",
    "setup:skills": "node scripts/setup-skills.cjs",
    "================TEST================": "",
    "test": "node --test test/*.test.cjs \"src/windows_feature/test/*.test.cjs\" \"src/apple_feature/test/*.test.cjs\" \"src/linux_feature/test/*.test.cjs\"",
    "doctor": "node scripts/doctor.cjs",
    "smoke": "npm run prepare:app && electron . --demo --smoke-test",
    "smoke:live": "npm run prepare:app && electron . --smoke-test",
    "smoke:onboarding": "npm run prepare:app && electron scripts/smoke-onboarding.cjs",
    "smoke:accounts": "npm run prepare:app && electron scripts/smoke-accounts.cjs",
    "smoke:updates": "npm run prepare:app && electron scripts/smoke-updates.cjs",
    "smoke:resets": "npm run prepare:app && electron scripts/smoke-resets.cjs",
    "smoke:panel-follow": "npm run prepare:app && electron scripts/smoke-windows-panel-follow.cjs",
    "smoke:linux-widget": "npm run prepare:app && electron src/linux_feature/scripts/smoke-widget.cjs",
    "smoke:widget-startup": "npm run prepare:app && electron src/windows_feature/scripts/smoke-widget-startup.cjs",
    "================BUILD================": "",
    "prepare:app": "node \"src/windows_feature/scripts/assets.cjs\" && node \"src/windows_feature/scripts/build-taskbar-helper.cjs\" && node \"src/apple_feature/scripts/build-helper.cjs\"",
    "prepare:assets": "node \"src/windows_feature/scripts/assets.cjs\"",
    "================BUILD WINDOWS================": "",
    "build:win": "node \"src/windows_feature/scripts/build-windows.cjs\"",
    "build:win:x64": "npm run build:win",
    "build:win:standalone": "node \"src/windows_feature/scripts/build-windows.cjs\" --standalone",
    "================BUILD MACOS================": "",
    "build:mac": "node scripts/build.cjs mac",
    "build:mac:arm64": "node scripts/build.cjs mac --arm64",
    "build:mac:x64": "node scripts/build.cjs mac --x64",
    "================BUILD LINUX================": "",
    "build:linux": "node scripts/build.cjs linux",
    "build:linux:x64": "node scripts/build.cjs linux --x64",
    "build:linux:arm64": "node scripts/build.cjs linux --arm64"
  },
  "devDependencies": {
    "@openai/codex": "0.162.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": { "sprintf-js": "1.1.4" },
  "build": {
    "appId": "dev.codexlimits.desktop",
    "productName": "Limits",
    "directories": { "output": "release" },
    "files": ["src/**/*", "!src/windows_feature/native/**/*", "!src/windows_feature/scripts/**/*", "!src/windows_feature/test/**/*", "!src/windows_feature/README.md", "!src/apple_feature/native/**/*", "!src/apple_feature/scripts/**/*", "!src/apple_feature/test/**/*", "!src/apple_feature/README.md", "!src/linux_feature/test/**/*", "!src/linux_feature/scripts/**/*", "!src/linux_feature/README.md", "assets/app.ico", "assets/app.png", "package.json", "LICENSE", "!node_modules/**/*"],
    "extraResources": [
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "win": { "target": ["portable", "nsis"], "icon": "assets/app.ico", "signExecutable": true, "extraResources": [{ "from": "build/taskbar-helper.exe", "to": "taskbar-helper.exe" }] },
    "mac": { "target": ["dmg", "zip"], "icon": "assets/app.png", "category": "public.app-category.utilities", "artifactName": "Limits-${version}-${arch}.${ext}" },
    "linux": { "target": ["AppImage", "deb"], "icon": "assets/app.png", "category": "Utility", "maintainer": "Limits contributors", "artifactName": "Limits-${version}-${arch}.${ext}" },
    "appImage": { "compression": "gzip" },
    "electronLanguages": ["en-US", "ru"],
    "compression": "maximum",
    "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "include": "src/windows_feature/native/installer.nsh", "installerLanguages": ["en_US", "ru_RU"], "displayLanguageSelector": true, "artifactName": "Limits-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Limits-${version}-portable.${ext}" }
  }
}
