{
  "name": "limits",
  "version": "1.8.0",
  "description": "Compact AI usage limits in your taskbar or system tray",
  "author": "Limits contributors",
  "homepage": "https://github.com/PyatkovVK/limits",
  "license": "MIT",
  "main": "src/main.cjs",
  "scripts": {
    "================SERVE================": "",
    "start": "npm run prepare:app && electron .",
    "demo": "npm run prepare:app && electron . --demo",
    "doctor": "node scripts/doctor/run.cjs",
    "setup:skills": "node scripts/prepare/setup-skills.cjs",
    "================TEST================": "",
    "test:common": "node --test \"test/*.test.cjs\"",
    "test:win": "node --test \"src/windows_feature/test/*.test.cjs\"",
    "test:win:smoke": "node test/smoke/run.cjs win",
    "test:mac": "node --test \"src/apple_feature/test/*.test.cjs\"",
    "test:mac:smoke": "node test/smoke/run.cjs mac",
    "test:linux": "node --test \"src/linux_feature/test/*.test.cjs\"",
    "test:linux:smoke": "node test/smoke/run.cjs linux",
    "================BUILD================": "",
    "prepare:app": "node scripts/prepare/prepare-app.cjs",
    "prepare:assets": "node scripts/prepare/assets.cjs",
    "================BUILD WINDOWS================": "",
    "build:win": "node scripts/build/windows.cjs",
    "build:win:x64": "npm run build:win",
    "build:win:standalone": "node scripts/build/windows.cjs --standalone",
    "================BUILD MACOS================": "",
    "build:mac": "node scripts/build/mac.cjs",
    "build:mac:arm64": "node scripts/build/mac.cjs --arm64",
    "build:mac:x64": "node scripts/build/mac.cjs --x64",
    "================BUILD LINUX================": "",
    "build:linux": "node scripts/build/linux.cjs",
    "build:linux:x64": "node scripts/build/linux.cjs --x64",
    "build:linux:arm64": "node scripts/build/linux.cjs --arm64"
  },
  "devDependencies": {
    "@openai/codex": "0.162.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "overrides": { "sprintf-js": "1.1.4" },
  "build": {
    "appId": "dev.codexlimits.desktop",
    "productName": "Limits",
    "directories": { "output": "release" },
    "files": ["src/main.cjs", "src/common/**/*", "!src/common/README.md", "package.json", "LICENSE", "!node_modules/**/*"],
    "extraResources": [
      { "from": "THIRD-PARTY-NOTICES.md", "to": "THIRD-PARTY-NOTICES.md" }
    ],
    "win": {
      "target": ["portable", "nsis"], "icon": "assets/app.ico", "signExecutable": true,
      "files": ["src/windows_feature/**/*", "!src/windows_feature/{native,scripts,test}/**/*", "assets/app.ico"],
      "extraResources": [{ "from": "build/taskbar-helper.exe", "to": "taskbar-helper.exe" }]
    },
    "mac": {
      "target": ["dmg", "zip"], "icon": "assets/app.png", "category": "public.app-category.utilities", "artifactName": "Limits-${version}-${arch}.${ext}",
      "files": ["src/apple_feature/**/*", "!src/apple_feature/{native,scripts}/**/*", "!src/apple_feature/test/**/*.test.cjs", "assets/app.png"]
    },
    "linux": {
      "target": ["AppImage", "deb"], "icon": "assets/app.png", "category": "Utility", "maintainer": "Limits contributors", "artifactName": "Limits-${version}-${arch}.${ext}",
      "files": ["src/linux_feature/**/*", "!src/linux_feature/test/**/*.test.cjs", "!src/linux_feature/README.md", "assets/app.png"]
    },
    "appImage": { "compression": "gzip" },
    "electronLanguages": ["en-US", "ru"],
    "compression": "maximum",
    "nsis": { "oneClick": false, "perMachine": false, "allowElevation": false, "allowToChangeInstallationDirectory": true, "include": "src/windows_feature/native/installer.nsh", "installerLanguages": ["en_US", "ru_RU"], "displayLanguageSelector": true, "artifactName": "Limits-Setup-${version}.${ext}" },
    "portable": { "artifactName": "Limits-${version}-portable.${ext}" }
  }
}
